{
  "name": "honpamang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "혼파망 — 익명 멘탈붕괴 공유 서비스",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
